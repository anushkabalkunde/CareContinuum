{
  "appId": "com.carecontinuum.app",
  "appName": "CareContinuum",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "minWebViewVersion": 60,
    "backgroundColor": "#FFFFFF",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    }
  }
}
